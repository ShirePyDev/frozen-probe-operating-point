# Example configuration. Every value below is an illustration, not a path or host we used.
# Set these in your shell, or copy this file to one of your own (keep it out of git) and export it:
#     set -a; . ./my.env; set +a
#
# ---------------------------------------------------------------------------------------------------------------------
# Reproducing the tables and figures (README, "Reproducing the tables and figures")
# ---------------------------------------------------------------------------------------------------------------------

# Directory the table and figure writers put their .tex files in. A relative value is taken from the repository root;
# keep it inside the repository, because the writers print the path relative to the root. Unset, they write to paper/.
# src/supp_tables_d585.py also READS tables_results.tex from here, so run src/results_tables_d504.py first.
GUARDRAIL_PAPER_DIR=build/tables

# ---------------------------------------------------------------------------------------------------------------------
# Re-running the experiments only (README, "Re-running the experiments")
# ---------------------------------------------------------------------------------------------------------------------

# Home directory of the account that runs the jobs. src/p2auroc_d424.py, src/recalnoise_d433.py and
# src/overrefusal_p2_d440.py put their sandbox and scratch directories under <this>/.cache/gccf_scratch.
# Unset, the current user's home is used.
GUARDRAIL_NODE_HOME=/path/to/home

# Hugging Face cache for weights and dataset snapshots. src/hf_env_guard.py refuses to run unless it is set and lies
# on an NVMe device as /proc/self/mounts reports it, and refuses an HF_ENDPOINT that is not https.
HF_HOME=/nvme/example/hf

# Hidden-state caches: directories searched before data/hidden (separated by ':' on Linux), and the directory new
# caches are written to (src/provenance.py).
GUARDRAIL_CACHE_DIRS=
GUARDRAIL_CACHE_WRITE_DIR=/nvme/example/caches

# LoRA adapters written by src/train_lora.py (unset: data/lora).
GUARDRAIL_LORA_DIR=/nvme/example/lora

# BLAS threads. A record stores the values it ran with; the compute node's environment set all three to 6.
OMP_NUM_THREADS=6
OPENBLAS_NUM_THREADS=6
MKL_NUM_THREADS=6

# The Hub token for gated checkpoints does NOT go here. src/fetch_weights.py reads HF_TOKEN from a file named .env at
# the repository root (ignored by git), sends it to huggingface.co only, and src/hf_env_guard.py refuses to run while a
# token is set in the environment.
